#!/usr/bin/env bash
set -euo pipefail

OLD_BACKUP="$HOME/.config.bak"
OLD_CONFIG="$HOME/.config"
NEW_CONFIG="/etc/skel/.config"

# delete backup if exists
if [[ -d "$OLD_BACKUP" ]]; then
    rm -R "$OLD_BACKUP"
fi

# move old config to backup if exists
if [[ -d "$OLD_CONFIG" ]]; then
    cp -Ra "$OLD_CONFIG" "$OLD_BACKUP"
fi

# set new config
cp -Ra --update=all "$NEW_CONFIG" "$HOME"